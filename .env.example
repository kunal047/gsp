# Supabase: copy the exact URI from Project -> Connect. Prefer the
# session pooler for this long-running backend when the host is IPv4-only.
# URL-encode special characters in the password and require TLS.
DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional legacy local database: replace DATABASE_URL with the line below and
# start Compose with `--profile local-db`.
# DATABASE_URL=postgresql+psycopg2://netra:netra@db:5432/netra

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300

# Analytics correctness controls. SEEK_SECONDS=0 uses the source's shared
# synchronized slot rather than independently seeking each camera.
SEEK_SECONDS=0
TRACK_MIN_HITS=3
TRACK_MAX_MISSES=3
TRACK_MIN_CONFIDENCE=0.45

# Optional fine-tuned vehicle model. Include an auto_rickshaw class in the map
# only when the supplied model was actually trained and validated for it.
# VEHICLE_MODEL=/models/gujarat-vehicles.pt
# VEHICLE_CLASS_MAP_JSON={"0":"auto_rickshaw","1":"bus","2":"car","3":"motorcycle","4":"truck"}

# Wrong-way remains unknown unless the expected image-plane travel direction is
# configured per camera (left/right/up/down).
# CAMERA_EXPECTED_DIRECTIONS_JSON={"GJ-CSITMS-001":"right"}

# Model 2/3 second-system connector. Each entry is normalized into the same
# registry, gateway and analytics contracts. Keep credentials only in .env.
# A second adapter-backed source is required for the official federation demo.
# RTSP_SOURCES_JSON=[{"source_system":"Participant VMS","external_id":"gate-1","name":"Gate 1","city":"Ahmedabad","site":"Participant test site","stream_url":"rtsp://user:password@host:554/stream","protocol":"RTSP","codec":"h264","analytics_enabled":true}]
